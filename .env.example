# SUPABASE_URL: رابط مشروع Supabase الخاص بك (مثلاً https://xyzcompany.supabase.co)
# قم بإضافته في لوحة الأسرار (Secrets Panel) في AI Studio أو ملف .env المحلي (غير المرفوع إلى Git)
SUPABASE_URL=https://your-project-ref.supabase.co

# SUPABASE_ANON_KEY: المفتاح العام الآمن (anon public key) من إعدادات Supabase API
# تنبيه أمني: لا تضع مفتاح service_role داخل التطبيق أبداً!
SUPABASE_ANON_KEY=your-supabase-anon-public-key
